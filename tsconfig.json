{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "rootDir": "assets/ts",
    "outDir": "public/js",
    "paths": {
      "@/*": ["./assets/ts/*"],
      "@components/*": ["./assets/ts/components/*"],
      "@data/*": ["./data/*"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "alwaysStrict": true,
    "skipLibCheck": true
  },
  "include": [
    "assets/ts/**/*"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "var",
    "public",
    "tests"
  ]
}
