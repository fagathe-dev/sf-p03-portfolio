{% extends 'base.html.twig' %}

{% block title %}{{ profile.fullName }} — Développeur Web Full-Stack{% endblock %}

{% block meta_description %}{{ profile.tagline|striptags }}{% endblock %}

{# ── Contenu principal ────────────────────────────────────────────────────── #}
{% block body %}

  {# ── Hero (pleine largeur, image de fond + voile du Design System) ─────── #}
  {# data-ui-theme="dark" : le texte et les boutons utilisent les tokens sombres, lisibles sur le voile #}
  <section
    class="hero hero-has-bg hero-portfolio"
    id="hero"
    aria-labelledby="hero-name"
    data-ui-theme="dark"
  >
    {# Image décorative (alt vide) : élément LCP, chargée en priorité #}
    <img
      src="{{ asset('images/photo-hero-1920.webp') }}"
      srcset="
        {{ asset('images/photo-hero-1280.webp') }} 1280w,
        {{ asset('images/photo-hero-1920.webp') }} 1920w,
        {{ asset('images/photo-hero-2624.webp') }} 2624w
      "
      sizes="100vw"
      alt=""
      class="hero-portfolio-img"
      width="2624"
      height="1530"
      fetchpriority="high"
      decoding="async"
    />

    <div class="container">

      <div class="hero-content">

        <span class="badge badge-soft-success badge-pill" aria-label="Disponible pour de nouvelles opportunités">
          <span class="status-dot" aria-hidden="true"></span>
          Disponible
        </span>

        <h1 class="display-2 mb-0" id="hero-name">{{ profile.fullName }}</h1>
        <p class="hero-subtitle">{{ profile.title }}</p>
        <p class="hero-tagline">{{ profile.tagline|raw }}</p>

        <p class="hero-location">
          <i class="mdi mdi-map-marker text-primary" aria-hidden="true"></i>
          <span>{{ profile.location }}</span>
        </p>

        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">Me contacter</a>
          <a
            href="{{ url('app_home_download_resume') }}"
            class="btn btn-outline-primary"
            aria-label="Télécharger le CV de {{ profile.fullName }}"
          >
            <i class="ri-download-2-line" aria-hidden="true"></i>
            Télécharger CV
          </a>
        </div>

        <ul class="hero-socials" aria-label="Réseaux sociaux">
          {% for social in profile.socials %}
            {% set finalLink = social.link %}
            {% if social.presetMessage is defined %}
              {% if social.name == 'Email' %}
                {% set finalLink = finalLink ~ '?subject=Contact via Portfolio&body=' ~ social.presetMessage|url_encode %}
              {% elseif social.name == 'WhatsApp' %}
                {% set finalLink = finalLink ~ '?text=' ~ social.presetMessage|url_encode %}
              {% endif %}
            {% endif %}

            <li>
              <a
                href="{{ finalLink }}"
                class="btn btn-icon btn-outline-secondary"
                aria-label="{{ social.name }}"
                {% if not (social.link starts with 'mailto') %}
                  target="_blank"
                  rel="noopener noreferrer"
                {% endif %}
              >
                <i class="{{ social.icon }}" aria-hidden="true"></i>
              </a>
            </li>
          {% endfor %}
        </ul>

      </div>

      <a href="#about" class="hero-scroll-hint" aria-label="Défiler vers la section À propos">
        <span class="hero-scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </section>

  {# ── À propos ──────────────────────────────────────────────────────────── #}
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title" id="about-title">À propos</h2>
      </header>
      {% include 'partials/_about.html.twig' %}
    </div>
  </section>

  {# ── Compétences ───────────────────────────────────────────────────────── #}
  <section class="section section-tinted" id="skills" aria-labelledby="skills-title">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title" id="skills-title">Compétences</h2>
      </header>
      {% include 'partials/_skills.html.twig' %}
    </div>
  </section>

  {# ── Projets ───────────────────────────────────────────────────────────── #}
  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title" id="projects-title">Projets</h2>
      </header>
      {% include 'partials/_projects.html.twig' %}
    </div>
  </section>

  {# ── Parcours ──────────────────────────────────────────────────────────── #}
  <section class="section section-tinted" id="timeline" aria-labelledby="timeline-title">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title" id="timeline-title">Parcours</h2>
      </header>
      {% include 'partials/_timeline.html.twig' %}
    </div>
  </section>

  {# ── Contact ───────────────────────────────────────────────────────────── #}
  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title" id="contact-title">Contact</h2>
      </header>
      {% block section_contact %}
        {% include 'partials/_contact.html.twig' %}
      {% endblock %}
    </div>
  </section>

{% endblock %}

{% block javascripts %}
  <script type="module" src="{{ asset('js/pages/homepage.js') }}"></script>
{% endblock %}
