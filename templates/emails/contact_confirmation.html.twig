{#
  Accusé de réception envoyé à l'auteur d'un message (App\Mail\ContactConfirmationHandler).
  Variables : dto (App\Dto\ContactDto), ownerName ; app_name, logo_url, support_email (core-php).
#}
{% extends '@CorePhp/layout.html.twig' %}

{% block preheader %}Merci {{ dto.fullName }}, votre message est bien arrivé. Voici le récapitulatif de votre demande.{% endblock %}

{% block content %}
  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h1',
    content: 'Votre message a bien été reçu, ' ~ (dto.fullName|e) ~ ' !'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    content: 'Merci de m\'avoir contacté. Je prends connaissance de votre message et vous répondrai dans les meilleurs délais.'
  } only %}

  {# ── Récapitulatif (valeurs échappées par le composant) ── #}
  {% set rows = [
    { label: 'Nom', value: dto.fullName },
    { label: 'E-mail', value: dto.email },
  ] %}
  {% if dto.phone %}
    {% set rows = rows|merge([{ label: 'Téléphone', value: dto.phone }]) %}
  {% endif %}
  {% set rows = rows|merge([{ label: 'Motif', value: dto.subjectLabel }]) %}
  {% if dto.linkProposition %}
    {% set rows = rows|merge([{ label: 'Lien', value: dto.linkProposition }]) %}
  {% endif %}

  {% include '@CorePhp/components/_text.html.twig' with { level: 'h3', content: 'Récapitulatif de votre demande' } only %}
  {% include '@CorePhp/components/_details.html.twig' with { rows: rows } only %}

  {% include '@CorePhp/components/_text.html.twig' with { level: 'h3', content: 'Votre message' } only %}
  {% include '@CorePhp/components/_box.html.twig' with { content: dto.message|e|nl2br } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    content: 'À bientôt,<br><strong>' ~ (ownerName|e) ~ '</strong>'
  } only %}

  {% include '@CorePhp/components/_divider.html.twig' only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    content: 'Cet e-mail est envoyé automatiquement depuis le formulaire de contact de mon portfolio. Pour compléter votre demande, répondez simplement à ce message.'
  } only %}
{% endblock %}
