{#
  Notification au propriétaire : message reçu via le formulaire de contact (App\Mail\ContactNotificationHandler).
  Variables : dto (App\Dto\ContactDto) ; app_name, logo_url, support_email (core-php).
  Reply-To = l'auteur : « Répondre » dans la messagerie lui écrit directement.
#}
{% extends '@CorePhp/layout.html.twig' %}

{% block preheader %}{{ dto.fullName }} · {{ dto.subjectLabel }} : {{ dto.message|slice(0, 90) }}{{ dto.message|length > 90 ? '…' }}{% endblock %}

{% block content %}
  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h1',
    content: 'Nouveau message depuis le portfolio'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    content: 'Reçu le ' ~ ('now'|date('d/m/Y à H:i'))
  } only %}

  {# ── Expéditeur et demande (valeurs échappées par le composant) ── #}
  {% set rows = [
    { label: 'Expéditeur', value: dto.fullName },
    { label: 'E-mail', value: dto.email, mono: true },
  ] %}
  {% if dto.phone %}
    {% set rows = rows|merge([{ label: 'Téléphone', value: dto.phone, mono: true }]) %}
  {% endif %}
  {% set rows = rows|merge([{ label: 'Motif', value: dto.subjectLabel, tone: 'primary' }]) %}
  {% if dto.linkProposition %}
    {% set rows = rows|merge([{ label: 'Lien de l\'offre / du projet', value: dto.linkProposition }]) %}
  {% endif %}

  {% include '@CorePhp/components/_details.html.twig' with { rows: rows } only %}

  {% include '@CorePhp/components/_text.html.twig' with { level: 'h3', content: 'Message' } only %}
  {% include '@CorePhp/components/_box.html.twig' with { content: dto.message|e|nl2br } only %}

  {% include '@CorePhp/components/_button.html.twig' with {
    url: 'mailto:' ~ dto.email ~ '?subject=' ~ ('Re: ' ~ dto.subjectLabel)|url_encode,
    label: 'Répondre à ' ~ dto.fullName,
  } only %}

  {% if dto.linkProposition %}
    {% include '@CorePhp/components/_button.html.twig' with {
      url: dto.linkProposition,
      label: 'Ouvrir le lien',
      variant: 'outline',
    } only %}
  {% endif %}
{% endblock %}
