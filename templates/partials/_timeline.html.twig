{# --- Parcours ----------------------------------------------------------------- #}

<ol class="timeline" aria-label="Parcours professionnel et formations">
  {% for item in timeline %}
    <li class="timeline-item" data-timeline-type="{{ item.type }}">

      <div class="timeline-marker" aria-hidden="true">
        {% if item.type == 'experience' %}
          <i class="mdi mdi-briefcase" aria-hidden="true"></i>
        {% else %}
          <i class="mdi mdi-school" aria-hidden="true"></i>
        {% endif %}
      </div>

      <article class="timeline-card">

        <header class="timeline-header">
          <span class="badge {{ item.type == 'experience' ? 'badge-soft-primary' : 'badge-soft-tertiary' }}">
            {{ item.type == 'experience' ? 'Expérience' : 'Formation' }}
          </span>
          <span class="timeline-dates">
            {{ item.startDate|slice(5, 2) }}/{{ item.startDate|slice(0, 4) }}
            {% if item.endDate %}
              — {{ item.endDate|slice(5, 2) }}/{{ item.endDate|slice(0, 4) }}
            {% else %}
              — Présent
            {% endif %}
          </span>
        </header>

        <h3 class="timeline-title">{{ item.title }}</h3>

        <p class="timeline-org">
          <span>{{ item.organization }}</span>
          <span class="timeline-location">{{ item.location }}</span>
        </p>

        {% if item.description %}
          <p class="timeline-description">{{ item.description }}</p>
        {% endif %}

        {% if item.highlights %}
          <ul class="timeline-highlights" aria-label="Points clés">
            {% for highlight in item.highlights %}
              <li>{{ highlight }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if item.stack %}
          <ul class="timeline-stack" aria-label="Technologies utilisées">
            {% for tech in item.stack %}
              <li class="chip chip-sm">{{ tech }}</li>
            {% endfor %}
          </ul>
        {% endif %}

      </article>
    </li>
  {% endfor %}
</ol>
