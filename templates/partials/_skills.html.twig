{# --- Compétences ------------------------------------------------------------- #}

{% set level_labels = {
  'debutant': 'Débutant',
  'intermediaire': 'Intermédiaire',
  'confirme': 'Confirmé',
  'confirmé': 'Confirmé',
  'senior': 'Senior',
  'expert': 'Expert'
} %}

{% set level_badges = {
  'debutant': 'badge-soft-tertiary',
  'intermediaire': 'badge-soft-secondary',
  'confirme': 'badge-soft-primary',
  'confirmé': 'badge-soft-primary',
  'senior': 'badge-soft-primary',
  'expert': 'badge-soft-primary'
} %}

{# Groupes affichés, dans l'ordre : catégorie du JSON → titre #}
{% set skill_groups = [
  { category: 'back_end', id: 'skills-backend', title: 'Back-end' },
  { category: 'front_end', id: 'skills-frontend', title: 'Front-end' },
  { category: 'other', id: 'skills-other', title: 'Outils & DevOps' },
  { category: 'ai', id: 'skills-ai', title: 'Outils IA' },
] %}

<div class="skills-stack">

  {% for group in skill_groups %}
    {% set group_skills = skills|filter(s => s.category == group.category) %}
    {% if group_skills|length > 0 %}
      <div class="skills-group">
        <h3 class="skills-group-title" id="{{ group.id }}">{{ group.title }}</h3>
        <ul class="skills-grid" aria-labelledby="{{ group.id }}">
          {% for skill in group_skills %}
            {% set level_label = level_labels[skill.level] ?? skill.level %}
            <li class="skill-card{% if skill.isHighlight %} is-highlighted{% endif %}">
              <i class="mdi {{ skill.icon }} skill-icon" aria-hidden="true"></i>
              <div class="skill-body">
                <span class="skill-label">{{ skill.label }}</span>
                <span class="badge {{ level_badges[skill.level] ?? 'badge-soft-secondary' }} skill-level">
                  <span class="visually-hidden">Niveau : </span>{{ level_label }}
                </span>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  {% endfor %}

</div>
