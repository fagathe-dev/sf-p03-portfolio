{% set baseURL = (app.request and app.request.attributes.get('_route') == 'app_home_index') ? '' : path('app_home_index') %}

<header class="app-header" id="navbar" role="banner">
  <nav class="navbar navbar-expand-lg" aria-label="Navigation principale">
    <div class="container">

      <button
        id="navbar-burger"
        class="navbar-toggler"
        type="button"
        data-ds-toggle="collapse"
        data-ds-target="#navbar-collapse"
        aria-expanded="false"
        aria-controls="navbar-collapse"
        aria-label="Ouvrir le menu de navigation"
      >
        <i class="ri-menu-line" aria-hidden="true"></i>
      </button>

      <a href="{{ baseURL }}#hero" class="navbar-brand" aria-label="Retour en haut de page">
        <img
          src="{{ asset(APP_LOGO) }}"
          alt="Logo de mon portfolio"
          srcset="{{ asset(APP_LOGO) }}"
          title="Logo de mon portfolio"
          width="40"
          height="40"
        />
      </a>

      <div class="collapse navbar-collapse" id="navbar-collapse">
        <ul class="navbar-nav">
          <li><a href="{{ baseURL }}#about" class="nav-link">À propos</a></li>
          <li><a href="{{ baseURL }}#skills" class="nav-link">Compétences</a></li>
          <li><a href="{{ baseURL }}#projects" class="nav-link">Projets</a></li>
          <li><a href="{{ baseURL }}#timeline" class="nav-link">Parcours</a></li>
          <li><a href="{{ baseURL }}#contact" class="nav-link">Contact</a></li>
        </ul>

        <div class="navbar-actions">
          <div
            class="segmented-control segmented-control-sm"
            role="radiogroup"
            aria-label="Thème d'affichage"
            data-ds-theme-switch
          >
            <button
              type="button"
              class="segmented-control-option"
              role="radio"
              aria-checked="true"
              data-value="auto"
              aria-label="Thème automatique"
              title="Automatique"
            >
              <i class="ri-computer-line" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="segmented-control-option"
              role="radio"
              aria-checked="false"
              data-value="light"
              aria-label="Thème clair"
              title="Clair"
            >
              <i class="ri-sun-line" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="segmented-control-option"
              role="radio"
              aria-checked="false"
              data-value="dark"
              aria-label="Thème sombre"
              title="Sombre"
            >
              <i class="ri-moon-line" aria-hidden="true"></i>
            </button>
          </div>

          <a
            href="{{ url('app_home_download_resume') }}"
            class="btn btn-outline-primary btn-sm"
            aria-label="Télécharger le CV{% if profile is defined %} de {{ profile.fullName }}{% endif %}"
          >
            <i class="ri-download-2-line" aria-hidden="true"></i>
            Télécharger CV
          </a>
        </div>
      </div>

    </div>
  </nav>
</header>
